# Kopieer naar .env om instellingen te wijzigen. Zet hier NOOIT echte broker-sleutels in.

# Alleen "true" is toegestaan: deze agent handelt uitsluitend met nepgeld.
PAPER_TRADING=true

# Startkapitaal van de nep-portefeuille in euro
STARTING_CASH_EUR=10000

# Max verlies per trade als de stop wordt geraakt (0.0025 = 0,25%; maximaal 1%)
RISK_PER_TRADE=0.0025

# Max opgeteld risico van alle open posities (0.01 = 1%; maximaal 3%)
MAX_OPEN_RISK=0.01

# Max aantal posities tegelijk
MAX_POSITIONS=3

# Optioneel: alleen deze tickers bekijken (komma-gescheiden, moeten in universe.py staan)
# TICKERS=ASML.AS,NVDA,SAP.DE
